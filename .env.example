# NeonDB (Postgres) - format: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# JWT
JWT_SECRET=super_secret_jwt_key_change_this

# Admin credentials (hardcoded super admin)
ADMIN_EMAIL=admin@taralaya.com
ADMIN_PASSWORD=changeme_strong_password

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_ORIGIN=http://localhost:5173
