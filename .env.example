# ─── Database ─────────────────────────────────────────────────────────────────
# NeonDB (Postgres) connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_change_this_in_production

# ─── Admin seed ───────────────────────────────────────────────────────────────
# Used by migrate-team.ts to create the first admin user
ADMIN_EMAIL=admin@taralaya.com
ADMIN_PASSWORD=changeme_strong_password

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# CORS: set to your frontend URL in production
# e.g. CLIENT_ORIGIN=https://taralaya-frontend.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ─── Frontend only (Vite) ─────────────────────────────────────────────────────
# Set this in the FRONTEND Vercel project env vars to point at your backend URL.
# Leave empty for local dev (Vite proxy handles /api -> localhost:3001 automatically).
# VITE_API_URL=https://taralaya-backend.vercel.app
